#!/bin/sh
set -eu

cd "$(dirname "$0")"

url="http://localhost:8888"

open_browser=

prompt_open_browser() {
  printf "Open browser at %s? [Y/n] " "$url"

  if [ -t 0 ]; then
    saved_tty=$(stty -g)
    stty cbreak -echo
    open_browser=$(dd bs=1 count=1 2>/dev/null || true)
    stty "$saved_tty"
    printf "\n"
  else
    read -r open_browser || open_browser=
  fi
}

case "${1:-}" in
  -s|--start)
    open_browser=n
    ;;
  -h|--help)
    echo "Usage: sh dev [-s|--start]"
    echo
    echo "Starts the local dev server."
    echo "Without -s/--start, prompts before opening a browser window."
    exit 0
    ;;
  "")
    prompt_open_browser
    ;;
  *)
    echo "Usage: sh dev [-s|--start]" >&2
    exit 2
    ;;
esac

if ! command -v php >/dev/null 2>&1; then
  echo "Error: php is not installed or not on PATH." >&2
  exit 1
fi

echo "Starting local dev server at $url"

if [ "$open_browser" != "n" ] && [ "$open_browser" != "N" ]; then
  (
    sleep 1
    open "$url"
  ) &
fi

exec php -S localhost:8888 -t htdocs htdocs/router.php
